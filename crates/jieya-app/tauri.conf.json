{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "解压开镜",
  "version": "0.1.0",
  "identifier": "cn.jieya.kaiming",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "解压开镜",
        "width": 1080,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "decorations": false,
        "dragDropEnabled": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
